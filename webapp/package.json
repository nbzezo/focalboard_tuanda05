{
	"name": "focalboard",
	"version": "8.0.0",
	"private": true,
	"description": "",
	"scripts": {
		"pack": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
		"packdev": "cross-env NODE_ENV=dev webpack --config webpack.dev.js",
		"watchdev": "cross-env NODE_ENV=dev webpack --watch --progress --config webpack.dev.js",
		"deveditor": "cross-env NODE_ENV=dev webpack server --config webpack.editor.js",
		"test": "jest",
		"updatesnapshot": "jest --updateSnapshot",
		"check": "eslint --ext .tsx,.ts . --quiet --cache && stylelint **/*.scss",
		"fix": "eslint --ext .tsx,.ts . --quiet --fix --cache && stylelint --fix **/*.scss",
		"fix:scss": "prettier --write './src/**/*.scss'",
		"i18n-extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"**/*.d.ts\" \"../**/*.d.ts\" --out-file i18n/tmp.json && formatjs compile i18n/tmp.json --out-file i18n/en.json && npx rimraf i18n/tmp.json",
		"runserver-test": "cd cypress && \"../../bin/focalboard-server\"",
		"cypress:ci": "start-server-and-test runserver-test http://localhost:8088 cypress:run",
		"cypress:debug": "start-server-and-test runserver-test http://localhost:8088 cypress:open",
		"cypress:run": "cypress run",
		"cypress:run:chrome": "cypress run --browser chrome",
		"cypress:run:firefox": "cypress run --browser firefox",
		"cypress:run:edge": "cypress run --browser edge",
		"cypress:run:electron": "cypress run --browser electron",
		"cypress:open": "cypress open"
	},
	"dependencies": {
		"@draft-js-plugins/editor": "^4.1.2",
		"@draft-js-plugins/emoji": "^4.6.0",
		"@draft-js-plugins/mention": "^5.1.2",
		"@emoji-mart/data": "^1.2.1",
		"@emoji-mart/react": "^1.1.1",
		"@fullcalendar/core": "^5.10.1",
		"@fullcalendar/daygrid": "^5.10.1",
		"@fullcalendar/interaction": "^5.10.1",
		"@fullcalendar/react": "^5.10.1",
		"@hello-pangea/dnd": "^16.6.0",
		"@mattermost/compass-icons": "^0.1.39",
		"@reduxjs/toolkit": "^1.8.0",
		"@tippyjs/react": "4.2.6",
		"classnames": "^2.5.1",
		"color": "^4.2.1",
		"date-fns": "^3.6.0",
		"draft-js": "^0.11.7",
		"dayjs": "^1.11.11",
		"emoji-mart": "^5.6.0",
		"fullcalendar": "^5.10.2",
		"lodash": "^4.17.21",
		"marked": "^4.0.12",
		"nanoevents": "^5.1.13",
		"react": "18.2.0",
		"react-day-picker": "^8.10.1",
		"react-dnd": "^16.0.1",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dnd-scrolling": "^1.3.10",
		"react-dnd-touch-backend": "^16.0.1",
		"react-dom": "18.2.0",
		"react-hot-keys": "^2.7.1",
		"react-hotkeys-hook": "^3.4.4",
		"react-intl": "^6.6.8",
		"react-redux": "^8.1.3",
		"react-router-dom": "^6.23.1",
		"react-select": "^5.2.2",
		"trim-newlines": "^4.0.2"
	},
	"jest": {
		"moduleNameMapper": {
			"\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
			"\\.(scss|css)$": "<rootDir>/__mocks__/styleMock.js",
			"^@emoji-mart/react$": "<rootDir>/src/test/emojiMartReactMock.tsx"
		},
		"transform": {
			"^.+\\.(t|j)sx?$": [
				"@swc/jest",
				{
					"jsc": {
						"transform": {
							"react": {
								"runtime": "automatic"
							}
						}
					}
				}
			]
		},
		"transformIgnorePatterns": [
			"/node_modules/(?!(nanoevents|react-dnd|react-dnd-html5-backend|react-dnd-touch-backend|react-dnd-scrolling|dnd-core|@react-dnd|@hello-pangea|@emoji-mart|emoji-mart)/)"
		],
		"maxWorkers": "50%",
		"testEnvironment": "jsdom",
		"setupFiles": [
			"<rootDir>/jest.setup.js"
		],
		"snapshotFormat": {
			"escapeString": true,
			"printBasicPrototype": true
		},
		"collectCoverage": true,
		"collectCoverageFrom": [
			"src/**/*.{ts,tsx,js,jsx}",
			"!src/test/**"
		]
	},
	"devDependencies": {
		"@formatjs/cli": "^4.8.2",
		"@formatjs/ts-transformer": "^3.9.2",
		"@swc/core": "^1.4.17",
		"@swc/jest": "^0.2.20",
		"@testing-library/cypress": "^10.0.1",
		"@testing-library/dom": "^9.3.4",
		"@testing-library/jest-dom": "^6.4.2",
		"@testing-library/react": "^14.3.1",
		"@testing-library/user-event": "^13.5.0",
		"@types/color": "^3.0.3",
		"@types/draft-js": "^0.11.9",
		"@types/jest": "^29.5.12",
		"@types/marked": "^4.0.3",
		"@types/nanoevents": "^1.0.0",
		"@types/node": "^20.14.0",
		"@types/react": "^18.2.79",
		"@types/react-dom": "^18.2.25",
		"@types/react-select": "^5.0.0",
		"@types/redux-mock-store": "^1.0.3",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"copy-webpack-plugin": "^10.2.4",
		"cross-env": "^7.0.3",
		"css-loader": "^6.7.1",
		"cypress": "^13.13.0",
		"cypress-failed-log": "^2.10.0",
		"cypress-real-events": "^1.12.0",
		"eslint": "^8.57.0",
		"eslint-import-resolver-webpack": "0.13.2",
		"eslint-plugin-babel": "^5.3.1",
		"eslint-plugin-cypress": "^2.15.2",
		"eslint-plugin-header": "3.1.1",
		"eslint-plugin-import": "2.25.4",
		"eslint-plugin-jquery": "1.5.1",
		"eslint-plugin-mattermost": "https://github.com/mattermost/eslint-plugin-mattermost/archive/23abcf9988f7fa00d26929f11841aab7ccb16b2b.tar.gz",
		"eslint-plugin-no-only-tests": "2.6.0",
		"eslint-plugin-react": "7.29.4",
		"fetch-mock-jest": "^1.5.1",
		"html-webpack-plugin": "^5.5.0",
		"isomorphic-fetch": "^3.0.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jest-mock": "^29.7.0",
		"prettier": "^2.6.1",
		"redux-mock-store": "^1.5.4",
		"sass": "^1.49.9",
		"sass-loader": "^12.6.0",
		"start-server-and-test": "^1.14.0",
		"style-loader": "^3.3.1",
		"stylelint": "^14.6.1",
		"stylelint-config-sass-guidelines": "^9.0.1",
		"terser-webpack-plugin": "^5.3.1",
		"ts-loader": "^9.2.8",
		"typescript": "~5.4.5",
		"webpack": "^5.90.0",
		"webpack-cli": "^4.9.2",
		"webpack-dev-server": "^4.11.1",
		"webpack-merge": "^5.8.0"
	},
	"optionalDependencies": {
		"cypress": "^13.13.0"
	},
	"overrides": {
		"@types/react-transition-group": "4.4.9"
	}
}
